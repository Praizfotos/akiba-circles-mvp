# Akiba Circles dApp configuration
# Copy these into webapp/.env.local and fill in the values.

# Stellar network: TESTNET or PUBLIC
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# RPC endpoint — do not change unless you run your own Soroban node
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed savings-circle contract ID (required for the app to connect)
# Deploy with: CONTRACT=savings-circle ./contracts/deploy.sh
NEXT_PUBLIC_SAVINGS_CIRCLE_CONTRACT_ID=

# USDC (or chosen SAC token) contract ID denoting the circle token
# Testnet USDC issuer: GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
NEXT_PUBLIC_USDC_CONTRACT_ID=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Optional: other token decimals override (default 7)
# NEXT_PUBLIC_TOKEN_DECIMALS=7

# Optional: default explorer URL derived from network
# NEXT_PUBLIC_EXPLORER_URL=https://stellar.expert/explorer/testnet/contract/